{
  "name": "etflimit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:all": "bash scripts/dev-all.sh",
    "build": "tsc -p tsconfig.json && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "api": "tsx src/api/server.ts",
    "start:api": "tsx src/api/server.ts",
    "sync:daily": "tsx src/sync/cli.ts daily",
    "sync:quotes": "tsx src/sync/cli.ts quotes",
    "sync:limits": "tsx src/sync/cli.ts limits",
    "sync:fees": "tsx src/sync/cli.ts fees",
    "sync:holdings": "tsx src/sync/cli.ts holdings",
    "acceptance": "tsx src/acceptance/cli.ts",
    "audit:tracking": "tsx src/audit/cli.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "better-sqlite3": "^11.10.0",
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0"
  }
